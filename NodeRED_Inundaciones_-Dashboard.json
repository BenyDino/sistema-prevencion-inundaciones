    "func": "const p=msg.payload;if(!p||typeof p!==\"object\")return null;const n=Number(p.nivel),d=Number(p.distancia_cm),r=Number(p.lluvia);if(![n,d,r].every(Number.isFinite)){node.warn(\"Payload MQTT sin nivel, distancia_cm o lluvia\");return null;}const on=v=>v===true||v===1||[\"1\",\"TRUE\",\"ON\",\"ENCENDIDA\",\"ACTIVADA\",\"ABIERTA\"].includes(String(v).toUpperCase());let e=String(p.estado||(n<50?\"NORMAL\":n<80?\"ALERTA\":\"CRITICO\")).toUpperCase();if(e===\"CRÍTICO\")e=\"CRITICO\";if(![\"NORMAL\",\"ALERTA\",\"CRITICO\",\"EMERGENCIA\"].includes(e))e=\"DESCONOCIDO\";const s={nivel:Math.max(0,Math.min(100,Math.round(n))),distancia_cm:Number(d.toFixed(2)),lluvia_adc:Math.max(0,Math.min(4095,Math.round(r))),estado:e,bomba:on(p.bomba),compuerta:on(p.compuerta),recibido:new Date().toLocaleTimeString(\"es-MX\")};flow.set(\"estado_inundacion\",s);msg.payload=s;return msg;",
